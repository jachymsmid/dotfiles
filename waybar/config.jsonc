// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 25,
    "spacing": 0,
    "fixed-center": true,
    "reload_style_on_change": true,
    "modules-left": [
      "clock",
      "cpu",
      "temperature",
      "memory"
    ],
    "modules-center": [
	    "hyprland/workspaces"
    ],
    "modules-right": [
      "hyprland/language",
      "power-profiles-daemon",
      "backlight",
	    "pulseaudio",
	    "network",
      "battery",
	    "custom/power"
    ],

    // modules config
    
    "cpu": {
      "format": "CPU: {usage}%",
      "on-click": "kitty htop",
      "states": {
        "default": 0,
        "normal" : 30,
        "elevated": 60,
        "extreme": 80
      }
    },
    "temperature": {
      "format": "TEMP: {temperatureC}°C",
      "states": {
        "normal": 0,
        "elevated": 50,
        "extreme": 70,
      }
    },
    "memory": {
      "format": "RAM: {used} / 16 GiB",
      "tooltip-format": "Using {percentage}% of memory",
      "on-click": "kitty htop",
      "states": {
        "default": 0,
        "normal" : 30,
        "elevated": 60,
        "extreme": 80
      }
    },
    "hyprland/workspaces": {
         "format": "{name}",
         "disable-scroll": true,
         "all-outputs": true,
         "warp-on-scroll": false,
     },
    "hyprland/language": {
        "format": "LANG: {}",
        "format-en": "EN",
        "format-cz": "CZ"
    },
 
    "clock": {
        "timezone": "Europe/Prague",
        "tooltip-format": "<big>{:%B %Y}</big>"
        // "format-alt": "{:%Y-%m-%d}"
    },

    "backlight": {
        // "device": "acpi_video1",
        "format": "Brightness:  {percent}%"//,
        //"format-icons": ["", "", "", "", "", "", "", "", ""]
    },

    "battery": {
        "states": {
            "good": 85,
            "warning": 20,
            "critical": 15
        },
        "format": "Charge: {capacity}%",
      	"tooltip": true,
      	"tooltip-format": "Time left: {time}"
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
    },

    "power-profiles-daemon": {
      "format": "Profile: {profile}",
      "tooltip-format": "Power profile: {profile} {icon}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },

    "network": {
        "format-wifi": "WiFi: {essid}",
        "format-ethernet": "Ethernet",
        "tooltip-format": "{essid} {signalStrength}%",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "Disconnected",
        "tooltip": true,
        "tooltip-format": "{essid} : {ipaddr}",
        "on-click": "kitty nmcli device wifi list"
    },

    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "Volume: {volume}%",
        "format-muted": "Muted",
	      "tooltip": true,
	      "tooltip-format": "Volume: {volume}%\nSource: {volume}%",
        "on-click": "pavucontrol"
    },

    "custom/power": {
      "format" : " 󰤆 ",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
      "menu-actions": {
			"shutdown": "poweroff",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		  }
    }
}
